<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- 1. HTTP -> HTTPS 301 强制跳转 -->
        <rule name="HTTP to HTTPS redirect" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <!-- 2. 无 www -> www 301 规范域名（SEO 唯一权威域） -->
        <rule name="Canonical host: add www" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^zzml\.com$" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://www.zzml.com/{R:1}" redirectType="Permanent" />
        </rule>
        <!-- 3. 去掉 html 结尾的尾部斜杠 -->
        <rule name="Remove trailing slash for .html files" stopProcessing="true">
          <match url="(.*)/$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" pattern=".*\.html$" negate="true" />
          </conditions>
          <action type="Redirect" url="{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
    <staticContent>
      <mimeMap fileExtension=".xml" mimeType="text/xml" />
      <mimeMap fileExtension=".txt" mimeType="text/plain" />
      <mimeMap fileExtension=".html" mimeType="text/html" />
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
    </staticContent>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <!-- HSTS: 让浏览器强制 HTTPS，一年有效；如需严格模式可去掉注释（确认子域名全走 HTTPS 后再开） -->
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
      </customHeaders>
    </httpProtocol>
    <httpCompression>
      <dynamicTypes>
        <clear />
        <add enabled="true" mimeType="text/html" />
        <add enabled="true" mimeType="text/plain" />
        <add enabled="true" mimeType="text/xml" />
        <add enabled="true" mimeType="text/css" />
        <add enabled="true" mimeType="application/javascript" />
        <add enabled="true" mimeType="application/json" />
      </dynamicTypes>
      <staticTypes>
        <clear />
        <add enabled="true" mimeType="text/html" />
        <add enabled="true" mimeType="text/plain" />
        <add enabled="true" mimeType="text/xml" />
        <add enabled="true" mimeType="text/css" />
        <add enabled="true" mimeType="application/javascript" />
        <add enabled="true" mimeType="application/json" />
        <add enabled="true" mimeType="image/svg+xml" />
      </staticTypes>
    </httpCompression>
  </system.webServer>
</configuration>
